var getLanguage,languagetype,curlang;
function getLangs(){
	$.ajax({
		type: 'get',
		url: '/goform/http_get_weblanguage_info',
		data: {},
		dataType:"json", 
		success: function(data) {
			if((typeof data)=='object'){
				var msg=data;
			}else{
				var msg=eval('('+data+')');
            }
            getLanguage=msg.setflag
            $("#System_lang").val(msg.languagetype);
            languagetype=msg.languagetype;
            if(languagetype=='en'){curlang=lang.en;}
		else if(languagetype=='ba'){curlang=lang.ba;}
		else if(languagetype=='de'){curlang=lang.de;}
		else if(languagetype=='tr'){curlang=lang.tr;}
		else if(languagetype=='fr'){curlang=lang.fr;}
		else{curlang=lang.ar;}
		getPage();
		},
		error:function(data){
		}
	})
}
getLangs();
function setLangs(){
    showanimation(1)
	$.ajax({
		type: 'post',
		url: '/goform/http_set_weblanguage_info',
		data: {"type":"setweblanguage","languagetype":$("#System_lang").val(),"setflag":1},
		dataType:"json", 
		success: function(data) {
			showanimation(5)
			window.location.reload();
		},
		error:function(data){
		}
	})
}
