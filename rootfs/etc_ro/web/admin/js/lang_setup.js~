    var currentLang=languagetype;
	if(currentLang=="en"){
		nowlang='en';
		return nowlang;
	}else if(currentLang=="ba"){
		nowlang='ba';
		return nowlang;
	}else if(currentLang=="tr"){
		nowlang='tr';
